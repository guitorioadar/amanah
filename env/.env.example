# Template — copy to env/.env.dev and env/.env.prod, then fill values.
# These real env files are gitignored. Non-secret config only; never commit
# secrets (see README). Bundled as assets and selected by FLAVOR.

# Human label of the loaded env file (`dev`/`prod`). Falls back to FLAVOR.
ENV_NAME=dev

# true  -> repositories use mock/dummy data (no backend)
# false -> repositories call the real API
USE_MOCK_API=true

# Base URL of the backend API (leave blank while USE_MOCK_API=true)
API_BASE_URL=
